# ─── API (NestJS) — copie para .env ──────────────────────────────────────────
NODE_ENV=development
PORT=3333
WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3333

# ─── Banco de dados ──────────────────────────────────────────────────────────
# Desenvolvimento: SQLite (arquivo local)
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./prisma/dev.db

# Produção: Supabase (Postgres). Troque DATABASE_PROVIDER e rode `npm run prisma:generate`.
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:<senha>@aws-0-<região>.pooler.supabase.com:5432/postgres

# ─── Autenticação ────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio-com-48-caracteres
JWT_EXPIRES_IN_HOURS=12

# ─── Arquivos (fotos) ────────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# Produção:
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=site-media

# ─── E-mail ──────────────────────────────────────────────────────────────────
# console = só imprime no terminal (links de convite aparecem aqui)
MAIL_DRIVER=console
# MAIL_DRIVER=resend
# RESEND_API_KEY=re_...
MAIL_FROM="Marcelo Ferreira Fotografia <nao-responda@seudominio.com.br>"

# ─── Seed (primeiro acesso) ──────────────────────────────────────────────────
SEED_OWNER_NAME="Marcelo Ferreira"
SEED_OWNER_EMAIL=marcelo@example.com
SEED_OWNER_PASSWORD=trocar-esta-senha

TRUST_PROXY=false
